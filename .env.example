# Copy to .env (gitignored) and fill in. NEVER commit real tokens.
# Slack surface (slack_app/app.py):
SLACK_BOT_TOKEN=xoxb-...        # Bot User OAuth token
SLACK_APP_TOKEN=xapp-...        # App-Level token (connections:write) for Socket Mode
# Real-Time Search evidence (constitution/evidence.RTSAdapter):
SLACK_RTS_TOKEN=xoxb-...        # token authorized for assistant.search.context
# Mediator (mediator/claude.ClaudeMediator):
ANTHROPIC_API_KEY=sk-ant-...    # or set ANTHROPIC_BASE_URL to an OpenClaw/qwen endpoint
# ANTHROPIC_BASE_URL=https://your-openclaw-endpoint
